<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Tauri apps on macOS. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Required for WebKit's JIT compiler (Tauri's webview). -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Required for spawning MCP server subprocesses (spec §6, Milestone 4).
       Without this entitlement, Process::new() calls will be blocked by
       Gatekeeper on notarized builds. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Required for the local OAuth loopback redirect (Milestone 6).
       Allows binding a local HTTP listener for the OAuth callback. -->
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Required for all outbound network requests — Ollama, MCP servers,
       OAuth token exchanges. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Required for reading/writing the SQLite memory database (spec §5). -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
